<Window x:Class="VideoGameLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:VideoGameLibrary.Converters"
        Title="Mi Colección de Juegos" Height="700" Width="1050" MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <conv:ByteArrayToImageConverter x:Key="ByteToImg"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:RatingToStarKindConverter x:Key="RatingToStar"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <md:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <md:PackIcon Kind="GamepadVariant" Width="28" Height="28"
                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Mi Colección de Juegos" FontSize="20" FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Barra de búsqueda + filtros -->
                <Grid Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             md:HintAssist.Hint="Buscar por título, plataforma o código de barras..."
                             md:TextFieldAssist.HasClearButton="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="White" CaretBrush="White"
                             BorderBrush="White"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"/>

                    <md:PopupBox Grid.Column="1" StaysOpen="True" PlacementMode="BottomAndAlignRightEdges"
                                  Margin="8,0,0,0" ToolTip="Filtros">
                        <md:PopupBox.ToggleContent>
                            <md:PackIcon Kind="FilterVariant" Foreground="White" Width="22" Height="22"/>
                        </md:PopupBox.ToggleContent>
                        <StackPanel Width="240">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380">
                                <StackPanel Margin="12">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Filtros" FontWeight="Medium" FontSize="14" VerticalAlignment="Center"/>
                                        <Button Content="Limpiar" Command="{Binding ClearFiltersCommand}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="4,0" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <TextBlock Text="Plataforma" FontWeight="Medium" FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,8,0,4"/>
                                    <ItemsControl ItemsSource="{Binding PlatformFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Value}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Género" FontWeight="Medium" FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,4"/>
                                    <ItemsControl ItemsSource="{Binding GenreFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Value}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Año" FontWeight="Medium" FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,4"/>
                                    <ItemsControl ItemsSource="{Binding YearFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Value}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Puntuación" FontWeight="Medium" FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,4"/>
                                    <ItemsControl ItemsSource="{Binding RatingFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                                                    <TextBlock Text="{Binding Value}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#FFC107"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Value}" Value="Sin puntuar">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </md:PopupBox>
                </Grid>

                <!-- Acciones -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignRaisedLightButton}"
                            Click="BtnAdd_Click" Margin="0,0,8,0"
                            md:ButtonAssist.CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Añadir juego" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedLightButton}"
                            Click="BtnExport_Click" Margin="0,0,8,0"
                            md:ButtonAssist.CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Export" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Exportar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Cambiar tema claro/oscuro" Click="BtnToggleTheme_Click">
                        <md:PackIcon x:Name="ThemeIcon" Kind="WeatherNight" Width="22" Height="22" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Ajustes — claves de API" Click="BtnSettings_Click">
                        <md:PackIcon Kind="Cog" Width="22" Height="22" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Registro de errores" Click="BtnLog_Click">
                        <md:PackIcon Kind="AlertCircleOutline" Width="22" Height="22" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </md:ColorZone>

        <!-- Barra de escaneo rápido -->
        <Border Grid.Row="1" Background="{DynamicResource MaterialDesignChipBackground}" Padding="16,8">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="BarcodeScan" Width="20" Height="20" VerticalAlignment="Center"
                             Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtQuickScan" Width="320"
                         md:HintAssist.Hint="Escaneo rápido: escanea o escribe un código y pulsa Enter"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding QuickScanBarcode, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="TxtQuickScan_KeyDown"/>
            </StackPanel>
        </Border>

        <!-- Loading bar -->
        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <!-- Grid de juegos -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="12">
            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <md:Card Margin="8" Width="160" Padding="0"
                                 UniformCornerRadius="8"
                                 md:ElevationAssist.Elevation="Dp2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Portada -->
                                <Border Grid.Row="0" CornerRadius="8,8,0,0" ClipToBounds="True">
                                    <Grid Background="{DynamicResource MaterialDesignChipBackground}">
                                        <Image Source="{Binding CoverData, Converter={StaticResource ByteToImg}}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding CoverData, Converter={StaticResource NullToVis}}"/>
                                        <md:PackIcon Kind="GamepadVariant" Width="60" Height="60"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                     Visibility="{Binding CoverData, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                                    </Grid>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Row="1" Margin="10,8,10,4">
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="12"
                                               TextTrimming="CharacterEllipsis" MaxHeight="36"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Platform}" FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Year}" FontSize="10"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               Margin="0,2,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <md:PackIcon Width="12" Height="12" Foreground="#FFC107"
                                                     Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=1}"/>
                                        <md:PackIcon Width="12" Height="12" Foreground="#FFC107"
                                                     Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=2}"/>
                                        <md:PackIcon Width="12" Height="12" Foreground="#FFC107"
                                                     Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=3}"/>
                                        <md:PackIcon Width="12" Height="12" Foreground="#FFC107"
                                                     Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=4}"/>
                                        <md:PackIcon Width="12" Height="12" Foreground="#FFC107"
                                                     Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=5}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Botones acción -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="4,0,4,4">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Ver ficha" Width="32" Height="32"
                                            Click="BtnView_Click" Tag="{Binding}">
                                        <md:PackIcon Kind="Eye" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Editar" Width="32" Height="32"
                                            Click="BtnEdit_Click" Tag="{Binding}">
                                        <md:PackIcon Kind="Pencil" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Eliminar" Width="32" Height="32"
                                            Foreground="OrangeRed"
                                            Click="BtnDelete_Click" Tag="{Binding}">
                                        <md:PackIcon Kind="Delete" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </md:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Estado vacío -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Games.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <md:PackIcon Kind="GamepadVariant" Width="80" Height="80"
                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                         HorizontalAlignment="Center"/>
            <TextBlock Text="Tu colección está vacía" FontSize="18" HorizontalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,4"/>
            <TextBlock Text="Pulsa &quot;Añadir juego&quot; o escanea un código de barras para empezar"
                       FontSize="13" HorizontalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>

        <!-- Statusbar -->
        <Border Grid.Row="4" Background="{DynamicResource MaterialDesignToolBarBackground}" Padding="16,6">
            <Grid>
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource MaterialDesignBodyLight}">
                    <Run Text="Total: "/>
                    <Run Text="{Binding TotalGames}" FontWeight="Medium"/>
                    <Run Text=" juegos"/>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontSize="12"/>
                <TextBlock Text="Mi Colección de Juegos v1.0" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
            </Grid>
        </Border>

        <!-- Snackbar de confirmación rápida no bloqueante -->
        <md:Snackbar Grid.Row="0" Grid.RowSpan="5" MessageQueue="{Binding SnackbarMessageQueue}"
                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="16"/>
    </Grid>
</Window>
