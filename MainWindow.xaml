<Window x:Class="VideoGameLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:VideoGameLibrary.Converters"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        Title="{Binding WindowTitle}" Height="700" Width="1050" MinHeight="500" MinWidth="700"
        Icon="Resources/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:ByteArrayToImageConverter x:Key="ByteToImg"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:RatingToStarKindConverter x:Key="RatingToStar"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <md:DialogHost Identifier="MainDialogHost">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <md:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <md:PackIcon Kind="GamepadVariant" Width="28" Height="28"
                                 VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Barra de búsqueda + filtros -->
                <Grid Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtSearch" Grid.Column="0"
                             md:HintAssist.Hint="Buscar por título, plataforma o código de barras..."
                             md:TextFieldAssist.HasClearButton="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Foreground="White" CaretBrush="White"
                             BorderBrush="White"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"/>

                    <md:PopupBox Grid.Column="1" StaysOpen="True" PlacementMode="BottomAndAlignRightEdges"
                                  Margin="8,0,0,0" ToolTip="Ordenar">
                        <md:PopupBox.ToggleContent>
                            <md:PackIcon Kind="ImportExport" Foreground="White" Width="22" Height="22"/>
                        </md:PopupBox.ToggleContent>
                        <StackPanel Width="220" Margin="12">
                            <TextBlock Text="Ordenar por" FontWeight="Medium" FontSize="14" Margin="0,0,0,8"/>
                            <RadioButton Content="Título (A-Z)" GroupName="SortGroup" Margin="0,4" IsChecked="True"
                                         Command="{Binding SetSortOptionCommand}" CommandParameter="Título (A-Z)"/>
                            <RadioButton Content="Plataforma" GroupName="SortGroup" Margin="0,4"
                                         Command="{Binding SetSortOptionCommand}" CommandParameter="Plataforma"/>
                            <RadioButton Content="Año (más reciente)" GroupName="SortGroup" Margin="0,4"
                                         Command="{Binding SetSortOptionCommand}" CommandParameter="Año (más reciente)"/>
                            <RadioButton Content="Añadido recientemente" GroupName="SortGroup" Margin="0,4"
                                         Command="{Binding SetSortOptionCommand}" CommandParameter="Añadido recientemente"/>
                        </StackPanel>
                    </md:PopupBox>

                    <md:PopupBox Grid.Column="2" StaysOpen="True" PlacementMode="BottomAndAlignRightEdges"
                                  Margin="8,0,0,0" ToolTip="Filtros">
                        <md:PopupBox.ToggleContent>
                            <md:PackIcon Kind="FilterVariant" Foreground="White" Width="22" Height="22"/>
                        </md:PopupBox.ToggleContent>
                        <StackPanel Width="240">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380">
                                <StackPanel Margin="12">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Filtros" FontWeight="Medium" FontSize="14" VerticalAlignment="Center"/>
                                        <Button Content="Limpiar" Command="{Binding ClearFiltersCommand}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="4,0" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <TextBlock Text="Plataforma" FontWeight="Medium" FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,8,0,4"/>
                                    <ItemsControl ItemsSource="{Binding PlatformFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Value}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Género" FontWeight="Medium" FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,4"/>
                                    <ItemsControl ItemsSource="{Binding GenreFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Value}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Etiquetas" FontWeight="Medium" FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,4"/>
                                    <ItemsControl ItemsSource="{Binding TagFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Value}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Año" FontWeight="Medium" FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,4"/>
                                    <ItemsControl ItemsSource="{Binding YearFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Value}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Puntuación" FontWeight="Medium" FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,4"/>
                                    <ItemsControl ItemsSource="{Binding RatingFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                                                    <TextBlock Text="{Binding Value}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#FFC107"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Value}" Value="Sin puntuar">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Estado" FontWeight="Medium" FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,4"/>
                                    <ItemsControl ItemsSource="{Binding PlayedFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Value}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Portada" FontWeight="Medium" FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,4"/>
                                    <CheckBox Content="Sin portada" IsChecked="{Binding OnlyMissingCover}" Margin="0,2"/>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </md:PopupBox>
                </Grid>

                <!-- Acciones -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignRaisedLightButton}"
                            Click="BtnAdd_Click" Margin="0,0,8,0"
                            md:ButtonAssist.CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Añadir juego" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedLightButton}"
                            Click="BtnExport_Click" Margin="0,0,8,0"
                            md:ButtonAssist.CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Export" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Exportar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Cambiar vista" Command="{Binding ToggleListViewCommand}">
                        <md:PackIcon Width="22" Height="22" Foreground="White">
                            <md:PackIcon.Style>
                                <Style TargetType="md:PackIcon">
                                    <Setter Property="Kind" Value="ViewGridOutline"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                                            <Setter Property="Kind" Value="ViewListOutline"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </md:PackIcon.Style>
                        </md:PackIcon>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Cambiar tema claro/oscuro" Click="BtnToggleTheme_Click">
                        <md:PackIcon x:Name="ThemeIcon" Kind="WeatherNight" Width="22" Height="22" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Registro de errores" Click="BtnLog_Click">
                        <md:PackIcon Kind="AlertCircleOutline" Width="22" Height="22" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </md:ColorZone>

        <!-- Barra de escaneo rápido -->
        <Border Grid.Row="1" Background="{DynamicResource MaterialDesignChipBackground}" Padding="16,6">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="BarcodeScan" Width="20" Height="20" VerticalAlignment="Center"
                             Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtQuickScan" Width="320" Padding="10,4"
                         md:HintAssist.Hint="Escaneo rápido: escanea o escribe un código y pulsa Enter"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding QuickScanBarcode, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="TxtQuickScan_KeyDown"/>
            </StackPanel>
        </Border>

        <!-- Barra de selección múltiple -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignChipBackground}" Padding="16,8"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisConv}}">
            <Grid>
                <TextBlock VerticalAlignment="Center" FontSize="13">
                    <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="Medium"/>
                    <Run Text=" seleccionado(s)"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="EXPORTAR SELECCIÓN" Click="BtnExportSelected_Click"
                            Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
                    <Button Content="ELIMINAR SELECCIÓN" Click="BtnDeleteSelected_Click"
                            Foreground="OrangeRed"
                            Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
                    <Button Content="CANCELAR" Command="{Binding ClearSelectionCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading bar -->
        <ProgressBar Grid.Row="3" IsIndeterminate="True" Height="3"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <!-- Grid de juegos (vista de tarjetas) -->
        <ListView Grid.Row="4" Padding="12" BorderThickness="0" Background="Transparent"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  Visibility="{Binding IsListView, Converter={StaticResource BoolToVisConv}, ConverterParameter=invert}"
                  ItemsSource="{Binding Games}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <md:Card Margin="8" Width="160" Padding="0"
                                 UniformCornerRadius="8"
                                 md:ElevationAssist.Elevation="Dp2">
                            <md:Card.CacheMode>
                                <!-- RenderAtScale > 1 evita el texto borroso que da BitmapCache por
                                     defecto en pantallas con escalado de Windows (125%, 150%...) -->
                                <BitmapCache RenderAtScale="2" SnapsToDevicePixels="True"/>
                            </md:Card.CacheMode>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Portada -->
                                <Border Grid.Row="0" CornerRadius="8,8,0,0" ClipToBounds="True">
                                    <Grid Background="{DynamicResource MaterialDesignChipBackground}">
                                        <Image Source="{Binding CoverData, Converter={StaticResource ByteToImg}, ConverterParameter=220}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding CoverData, Converter={StaticResource NullToVis}}"/>
                                        <md:PackIcon Kind="GamepadVariant" Width="60" Height="60"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                     Visibility="{Binding CoverData, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                                        <Border Width="26" Height="26" CornerRadius="13" Margin="6"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="#66000000">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                                                  Direction="270" Opacity="0.55" Color="Black"/>
                                            </Border.Effect>
                                            <CheckBox IsChecked="{Binding IsSelected}" Width="18" Height="18"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <CheckBox.Template>
                                                    <ControlTemplate TargetType="CheckBox">
                                                        <Grid>
                                                            <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="1.6" Fill="Transparent"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </CheckBox.Template>
                                            </CheckBox>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Row="1" Margin="10,8,10,4">
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="12"
                                               TextTrimming="CharacterEllipsis" Height="32"
                                               VerticalAlignment="Top" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Platform}" FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Year}" FontSize="10"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               Margin="0,2,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <md:PackIcon Width="12" Height="12" Foreground="#FFC107"
                                                     Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=1}"/>
                                        <md:PackIcon Width="12" Height="12" Foreground="#FFC107"
                                                     Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=2}"/>
                                        <md:PackIcon Width="12" Height="12" Foreground="#FFC107"
                                                     Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=3}"/>
                                        <md:PackIcon Width="12" Height="12" Foreground="#FFC107"
                                                     Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=4}"/>
                                        <md:PackIcon Width="12" Height="12" Foreground="#FFC107"
                                                     Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=5}"/>
                                    </StackPanel>

                                    <!-- Altura fija (no crece con el nº de etiquetas) para que todas las
                                         tarjetas midan igual bajo VirtualizingWrapPanel. CardVisibleTags
                                         (GameViewModel) ya decide cuántas etiquetas completas caben —
                                         ClipToBounds se deja solo como red de seguridad, no como recorte
                                         principal. El resto se resume en "+N"; la ficha de detalle
                                         siempre muestra la lista completa. -->
                                    <StackPanel Orientation="Horizontal" Height="18" Margin="0,4,0,0">
                                        <ItemsControl ItemsSource="{Binding CardVisibleTags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" ClipToBounds="True"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <md:PackIcon Kind="Tag" Width="10" Height="10" VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                                        <TextBlock Text="{Binding}" FontSize="9" Margin="2,0,0,0" VerticalAlignment="Center"
                                                                   MaxWidth="80" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding CardHiddenTagCount, StringFormat='+{0}'}" FontSize="9"
                                                   FontWeight="Medium" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                   Visibility="{Binding HasHiddenTags, Converter={StaticResource BoolToVisConv}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Botones acción -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="4,0,4,4">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Ver ficha" Width="32" Height="32"
                                            Click="BtnView_Click" Tag="{Binding}">
                                        <md:PackIcon Kind="Eye" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Editar" Width="32" Height="32"
                                            Click="BtnEdit_Click" Tag="{Binding}">
                                        <md:PackIcon Kind="Pencil" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Ya lo tengo — mover a la colección" Width="32" Height="32"
                                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                                            Click="BtnMoveToCollection_Click" Tag="{Binding}"
                                            Visibility="{Binding IsWishlist, Converter={StaticResource BoolToVisConv}}">
                                        <md:PackIcon Kind="CartCheck" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Eliminar" Width="32" Height="32"
                                            Foreground="OrangeRed"
                                            Click="BtnDelete_Click" Tag="{Binding}">
                                        <md:PackIcon Kind="Delete" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </md:Card>
                    </DataTemplate>
                </ListView.ItemTemplate>
        </ListView>

        <!-- Lista de juegos (vista compacta) -->
        <ListView Grid.Row="4" Padding="8" BorderThickness="0" Background="Transparent"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  Visibility="{Binding IsListView, Converter={StaticResource BoolToVisConv}}"
                  ItemsSource="{Binding Games}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <Border Grid.Column="1" Width="48" Height="48" CornerRadius="4"
                                        ClipToBounds="True" Margin="0,0,12,0">
                                    <Grid Background="{DynamicResource MaterialDesignChipBackground}">
                                        <Image Source="{Binding CoverData, Converter={StaticResource ByteToImg}, ConverterParameter=96}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding CoverData, Converter={StaticResource NullToVis}}"/>
                                        <md:PackIcon Kind="GamepadVariant" Width="22" Height="22"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                     Visibility="{Binding CoverData, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="13"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{Binding Platform, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Year, Mode=OneWay}"/>
                                    </TextBlock>
                                    <ItemsControl Margin="0,3,0,0" ItemsSource="{Binding TagList}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,10,2" VerticalAlignment="Center">
                                                    <md:PackIcon Kind="Tag" Width="10" Height="10" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                                    <TextBlock Text="{Binding}" FontSize="9" Margin="2,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                    <md:PackIcon Width="14" Height="14" Foreground="#FFC107"
                                                 Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=1}"/>
                                    <md:PackIcon Width="14" Height="14" Foreground="#FFC107"
                                                 Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=2}"/>
                                    <md:PackIcon Width="14" Height="14" Foreground="#FFC107"
                                                 Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=3}"/>
                                    <md:PackIcon Width="14" Height="14" Foreground="#FFC107"
                                                 Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=4}"/>
                                    <md:PackIcon Width="14" Height="14" Foreground="#FFC107"
                                                 Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=5}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Ver ficha" Width="32" Height="32"
                                            Click="BtnView_Click" Tag="{Binding}">
                                        <md:PackIcon Kind="Eye" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Editar" Width="32" Height="32"
                                            Click="BtnEdit_Click" Tag="{Binding}">
                                        <md:PackIcon Kind="Pencil" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Ya lo tengo — mover a la colección" Width="32" Height="32"
                                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                                            Click="BtnMoveToCollection_Click" Tag="{Binding}"
                                            Visibility="{Binding IsWishlist, Converter={StaticResource BoolToVisConv}}">
                                        <md:PackIcon Kind="CartCheck" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Eliminar" Width="32" Height="32"
                                            Foreground="OrangeRed"
                                            Click="BtnDelete_Click" Tag="{Binding}">
                                        <md:PackIcon Kind="Delete" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
        </ListView>

        <!-- Estado vacío -->
        <StackPanel Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Games.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <md:PackIcon Kind="GamepadVariant" Width="80" Height="80"
                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                         HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding EmptyStateTitle}" FontSize="18" HorizontalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,4"/>
            <TextBlock Text="{Binding EmptyStateSubtitle}"
                       FontSize="13" HorizontalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>

        <!-- Statusbar -->
        <Border Grid.Row="5" Background="{DynamicResource MaterialDesignToolBarBackground}" Padding="16,6">
            <Grid>
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource MaterialDesignBodyLight}">
                    <Run Text="Total: "/>
                    <Run Text="{Binding TotalGames}" FontWeight="Medium"/>
                    <Run Text=" "/>
                    <Run Text="{Binding TotalSuffixText}"/>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontSize="12"/>
                <TextBlock Text="Mi Colección de Juegos v1.0" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
            </Grid>
        </Border>

        <!-- Snackbar de confirmación rápida no bloqueante -->
        <md:Snackbar Grid.Row="0" Grid.RowSpan="6" MessageQueue="{Binding SnackbarMessageQueue}"
                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="16"/>

        <!-- Botón flotante: lista de deseos, estadísticas y papelera -->
        <Grid Grid.Row="0" Grid.RowSpan="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16">
            <StackPanel HorizontalAlignment="Center">
                <!-- Opciones: aparecen encima del botón principal, con una pequeña animación de aparición -->
                <StackPanel x:Name="FabOptions" RenderTransformOrigin="0.5,1">
                    <StackPanel.RenderTransform>
                        <ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
                    </StackPanel.RenderTransform>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Opacity" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFabOpen}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.7" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.7" Duration="0:0:0.12"/>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" BeginTime="0:0:0.12">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border x:Name="FabSettings" Width="40" Height="40" CornerRadius="20" Margin="0,0,0,10"
                            Cursor="Hand" Tag="settings" MouseLeftButtonUp="FabOption_Click"
                            md:ElevationAssist.Elevation="Dp3" ToolTip="Ajustes">
                        <md:PackIcon Kind="Cog" Width="18" Height="18" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="FabShortcuts" Width="40" Height="40" CornerRadius="20" Margin="0,0,0,10"
                            Cursor="Hand" Tag="shortcuts" MouseLeftButtonUp="FabOption_Click"
                            md:ElevationAssist.Elevation="Dp3" ToolTip="Atajos de teclado">
                        <md:PackIcon Kind="KeyboardOutline" Width="18" Height="18" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="FabTrash" Width="40" Height="40" CornerRadius="20" Margin="0,0,0,10"
                            Cursor="Hand" Tag="trash" MouseLeftButtonUp="FabOption_Click"
                            md:ElevationAssist.Elevation="Dp3" ToolTip="Papelera">
                        <md:PackIcon Kind="TrashCanOutline" Width="18" Height="18" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="FabStats" Width="40" Height="40" CornerRadius="20" Margin="0,0,0,10"
                            Cursor="Hand" Tag="stats" MouseLeftButtonUp="FabOption_Click"
                            md:ElevationAssist.Elevation="Dp3" ToolTip="Estadísticas">
                        <md:PackIcon Kind="ChartBar" Width="18" Height="18" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="FabWishlist" Width="40" Height="40" CornerRadius="20" Margin="0,0,0,10"
                            Cursor="Hand" Tag="wishlist" MouseLeftButtonUp="FabOption_Click"
                            md:ElevationAssist.Elevation="Dp3">
                        <Border.ToolTip>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Lista de deseos"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWishlistView}" Value="True">
                                                <Setter Property="Text" Value="Ver colección"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border.ToolTip>
                        <md:PackIcon Width="18" Height="18" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                            <md:PackIcon.Style>
                                <Style TargetType="md:PackIcon">
                                    <Setter Property="Kind" Value="HeartOutline"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWishlistView}" Value="True">
                                            <Setter Property="Kind" Value="Heart"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </md:PackIcon.Style>
                        </md:PackIcon>
                    </Border>
                </StackPanel>

                <!-- Botón principal: alterna + / X -->
                <Border x:Name="FabMain" Width="48" Height="48" CornerRadius="24"
                        Cursor="Hand" MouseLeftButtonUp="FabToggle_Click"
                        md:ElevationAssist.Elevation="Dp4">
                    <md:PackIcon Width="22" Height="22" Foreground="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                        <md:PackIcon.Style>
                            <Style TargetType="md:PackIcon">
                                <Setter Property="Kind" Value="Plus"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFabOpen}" Value="True">
                                        <Setter Property="Kind" Value="Close"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                </Style>
                            </md:PackIcon.Style>
                        </md:PackIcon>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
    </md:DialogHost>
</Window>
