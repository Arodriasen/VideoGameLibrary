<Window x:Class="VideoGameLibrary.Presentation.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Recuperar contraseña" Height="560" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <md:DialogHost Identifier="ForgotPasswordDialogHost">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="LockOutline" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Recuperar contraseña" FontSize="18" FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">

            <!-- Paso 1: pedir el código por correo -->
            <StackPanel x:Name="StepRequestCode">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="12"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           Text="Te enviaremos un código a tu correo para que puedas poner una contraseña nueva."/>
                <TextBox x:Name="TxtEmail" md:HintAssist.Hint="Correo electrónico"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                <Button x:Name="BtnSendCode" Content="ENVIAR CÓDIGO" Click="BtnSendCode_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        HorizontalAlignment="Left" Margin="0,16,0,0"
                        md:ButtonAssist.CornerRadius="4"/>
            </StackPanel>

            <!-- Paso 2: código recibido + contraseña nueva -->
            <StackPanel x:Name="StepResetPassword" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="12"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           Text="Introduce el código que has recibido por correo y tu contraseña nueva."/>
                <TextBox x:Name="TxtCode" md:HintAssist.Hint="Código recibido por correo"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                <PasswordBox x:Name="TxtNewPassword" Margin="0,16,0,0"
                             md:HintAssist.Hint="Contraseña nueva"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"/>
                <PasswordBox x:Name="TxtConfirmPassword" Margin="0,16,0,0"
                             md:HintAssist.Hint="Repite la contraseña nueva"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"/>
                <Button x:Name="BtnResetPassword" Content="CAMBIAR CONTRASEÑA" Click="BtnResetPassword_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        HorizontalAlignment="Left" Margin="0,16,0,0"
                        md:ButtonAssist.CornerRadius="4"/>
            </StackPanel>

            <ProgressBar x:Name="LoadingIndicator" IsIndeterminate="True" Height="4" Margin="0,16,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="CERRAR" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}"/>
        </StackPanel>
    </Grid>
    </md:DialogHost>
</Window>
