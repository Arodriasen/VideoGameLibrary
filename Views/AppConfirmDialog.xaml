<UserControl x:Class="VideoGameLibrary.Views.AppConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             FontFamily="{DynamicResource MaterialDesignFont}"
             MinWidth="300" MaxWidth="420">
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <md:PackIcon Kind="AlertCircleOutline" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0"
                         Foreground="#FFA000"/>
            <TextBlock x:Name="TxtTitle" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock x:Name="TxtMessage" TextWrapping="Wrap" Margin="0,0,0,20" FontSize="13"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="NO" Command="{x:Static md:DialogHost.CloseDialogCommand}" CommandParameter="False"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
            <Button Content="SÍ" Command="{x:Static md:DialogHost.CloseDialogCommand}" CommandParameter="True"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    md:ButtonAssist.CornerRadius="4"/>
        </StackPanel>
    </StackPanel>
</UserControl>
