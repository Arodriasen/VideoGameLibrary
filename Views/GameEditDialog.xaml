<Window x:Class="VideoGameLibrary.Views.GameEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:VideoGameLibrary.Converters"
        Title="{Binding DialogTitle}" Height="825" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <conv:ByteArrayToImageConverter x:Key="ByteToImg"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:RatingToStarKindConverter x:Key="RatingToStar"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header código de barras -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtBarcode" Width="260" Margin="0,0,8,0"
                         md:HintAssist.Hint="Código de barras (UPC/EAN) - escanear o escribir"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="TxtBarcode_KeyDown"/>
                <Button Content="BUSCAR" Command="{Binding SearchCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        md:ButtonAssist.CornerRadius="4"/>
            </StackPanel>
            <Button Content="ELEGIR OTRO RESULTADO" Command="{Binding PickAgainCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" FontSize="11"
                    Padding="4,2" Margin="0,4,0,0" HorizontalAlignment="Left"
                    Visibility="{Binding CanPickAgain, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- Contenido -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Portada -->
            <Border Grid.Column="0" Width="120" Height="170" CornerRadius="4"
                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                    Background="{DynamicResource MaterialDesignChipBackground}"
                    VerticalAlignment="Top" Margin="0,0,12,0">
                <Grid>
                    <Image Source="{Binding CoverData, Converter={StaticResource ByteToImg}}"
                           Stretch="UniformToFill"
                           Visibility="{Binding CoverData, Converter={StaticResource NullToVis}}"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding CoverData, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                        <md:PackIcon Kind="GamepadVariant" Width="40" Height="40"
                                     Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock Text="Sin portada" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <!-- Botón cambiar portada -->
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Cambiar portada" Click="BtnChangeCover_Click"
                            VerticalAlignment="Bottom" HorizontalAlignment="Right"
                            Padding="4" Width="28" Height="28" Margin="0,0,2,2">
                        <md:PackIcon Kind="Image" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Campos -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             md:HintAssist.Hint="Título *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Buscar por nombre (si no se encontró por código de barras)"
                            Command="{Binding SearchByNameCommand}"
                            Margin="4,0,0,0">
                        <md:PackIcon Kind="Magnify" Width="20" Height="20"/>
                    </Button>
                </Grid>

                <TextBox Margin="0,0,0,12"
                         md:HintAssist.Hint="Plataforma"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding Platform, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Margin="0,0,0,12"
                         md:HintAssist.Hint="Editorial"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Margin="0,0,0,12"
                         md:HintAssist.Hint="Género"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Margin="0,0,0,12"
                         md:HintAssist.Hint="Etiquetas — libres, separadas por comas"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Margin="0,0,0,12"
                         md:HintAssist.Hint="Año"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Tu puntuación" FontSize="11" FontWeight="Medium"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Style="{StaticResource MaterialDesignIconButton}" Padding="2" Width="32" Height="32"
                            Command="{Binding SetRatingCommand}" CommandParameter="1">
                        <md:PackIcon Width="22" Height="22" Foreground="#FFC107"
                                     Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=1}"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Padding="2" Width="32" Height="32"
                            Command="{Binding SetRatingCommand}" CommandParameter="2">
                        <md:PackIcon Width="22" Height="22" Foreground="#FFC107"
                                     Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=2}"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Padding="2" Width="32" Height="32"
                            Command="{Binding SetRatingCommand}" CommandParameter="3">
                        <md:PackIcon Width="22" Height="22" Foreground="#FFC107"
                                     Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=3}"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Padding="2" Width="32" Height="32"
                            Command="{Binding SetRatingCommand}" CommandParameter="4">
                        <md:PackIcon Width="22" Height="22" Foreground="#FFC107"
                                     Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=4}"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Padding="2" Width="32" Height="32"
                            Command="{Binding SetRatingCommand}" CommandParameter="5">
                        <md:PackIcon Width="22" Height="22" Foreground="#FFC107"
                                     Kind="{Binding Rating, Converter={StaticResource RatingToStar}, ConverterParameter=5}"/>
                    </Button>
                </StackPanel>

                <CheckBox Content="Jugado" IsChecked="{Binding Played}" Margin="0,0,0,8"/>
                <CheckBox Content="Wishlist" IsChecked="{Binding IsWishlist}" Margin="0,0,0,12"/>

                <TextBox Margin="0,0,0,0"
                         md:HintAssist.Hint="Notas personales"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Height="80" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Grid>

        <!-- Buscando indicator -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3"
                     VerticalAlignment="Bottom" Margin="0,0,0,-8"
                     Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>

        <!-- Botones -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <TextBlock x:Name="TxtError" Foreground="Red" VerticalAlignment="Center"
                       Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="200"
                       Text="{Binding ErrorMessage}"/>
            <Button Content="CANCELAR" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    IsCancel="True" Click="BtnCancel_Click"/>
            <Button Content="GUARDAR" Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    md:ButtonAssist.CornerRadius="4"/>
        </StackPanel>
    </Grid>
</Window>
