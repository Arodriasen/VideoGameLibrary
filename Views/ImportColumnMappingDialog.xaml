<Window x:Class="VideoGameLibrary.Views.ImportColumnMappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Emparejar columnas" Height="560" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="TableColumn" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Emparejar columnas" FontSize="18" FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Text="Indica qué columna de tu archivo corresponde a cada campo. Ya hemos adivinado las que coinciden por nombre — revisa y corrige si hace falta. &quot;Título&quot; es obligatorio."/>
        </StackPanel>

        <!-- Filas de mapeo -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13"
                                       Text="{Binding DisplayLabel, Mode=OneWay}"/>

                            <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                      SelectedItem="{Binding SelectedOption}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="TxtError" Grid.Row="2" Foreground="Red" TextWrapping="Wrap"
                   Margin="0,4,0,0" FontSize="12" Visibility="Collapsed"
                   Text="Tienes que emparejar la columna de &quot;Título&quot; para poder continuar."/>

        <!-- Botones -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="CANCELAR" Click="BtnCancel_Click" IsCancel="True"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
            <Button Content="CONTINUAR" Click="BtnContinue_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    md:ButtonAssist.CornerRadius="4"/>
        </StackPanel>
    </Grid>
</Window>
