<Window x:Class="VideoGameLibrary.Views.LogViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Registro de errores" Height="560" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <md:DialogHost Identifier="LogViewerDialogHost">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="AlertCircleOutline" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Registro de errores" FontSize="18" FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Text="Aquí se registran los errores inesperados y los fallos de las APIs de búsqueda (código de barras, portadas, etc.), útiles para diagnosticar un problema sin tener que reproducirlo."/>
        </StackPanel>

        <!-- Contenido del log -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8">
                    <TextBox x:Name="TxtLog" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                </ScrollViewer>
                <TextBlock x:Name="TxtEmpty" Text="No hay errores registrados." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Botones -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="ABRIR CARPETA" Click="BtnOpenFolder_Click"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
            <Button Content="LIMPIAR" Click="BtnClear_Click"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
            <Button Content="CERRAR" Click="BtnClose_Click" IsCancel="True"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    md:ButtonAssist.CornerRadius="4"/>
        </StackPanel>
    </Grid>
    </md:DialogHost>
</Window>
