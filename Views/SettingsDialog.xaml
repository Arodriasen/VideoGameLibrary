<Window x:Class="VideoGameLibrary.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Ajustes — Claves de API" Height="560" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="KeyVariant" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Claves de API" FontSize="18" FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="TxtIntro" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Text="Todas las claves son opcionales y mejoran la búsqueda automática al escanear un código de barras. Se guardan solo en este ordenador. Puedes dejarlas en blanco y añadirlas más tarde."/>
        </StackPanel>

        <!-- Campos -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBox x:Name="TxtScanDex" Margin="0,8,0,0"
                         md:HintAssist.Hint="ScanDex Token"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <TextBox x:Name="TxtIgdbClientId" Margin="0,16,0,0"
                         md:HintAssist.Hint="IGDB Client ID"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <TextBox x:Name="TxtIgdbClientSecret" Margin="0,16,0,0"
                         md:HintAssist.Hint="IGDB Client Secret"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <TextBox x:Name="TxtRawg" Margin="0,16,0,0"
                         md:HintAssist.Hint="RAWG API Key"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <TextBox x:Name="TxtGamesDb" Margin="0,16,0,0"
                         md:HintAssist.Hint="TheGamesDB API Key"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <Separator x:Name="MaintenanceSeparator" Margin="0,24,0,0"/>

                <StackPanel x:Name="MaintenanceSection" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="DatabaseCogOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Mantenimiento" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,10" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Text="Al borrar un juego, el archivo .db no reduce su tamaño ni elimina físicamente los datos hasta que se compacta. Esto es normal en SQLite y no afecta al funcionamiento de la app, pero puedes compactarlo manualmente cuando quieras."/>
                    <Button x:Name="BtnVacuum" Content="COMPACTAR BASE DE DATOS" Click="BtnVacuum_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            HorizontalAlignment="Left"
                            md:ButtonAssist.CornerRadius="4"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnCancel" Content="CANCELAR" Click="BtnCancel_Click" IsCancel="True"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
            <Button Content="GUARDAR" Click="BtnSave_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    md:ButtonAssist.CornerRadius="4"/>
        </StackPanel>
    </Grid>
</Window>
