<Window x:Class="VideoGameLibrary.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Ajustes — Claves de API" Height="560" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <md:DialogHost Identifier="SettingsDialogHost">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="KeyVariant" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Claves de API" FontSize="18" FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="TxtIntro" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Text="Todas las claves son opcionales y mejoran la búsqueda automática al escanear un código de barras. Se guardan solo en este ordenador. Puedes dejarlas en blanco y añadirlas más tarde."/>
        </StackPanel>

        <!-- Campos -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBox x:Name="TxtScanDex" Margin="0,8,0,0"
                         md:HintAssist.Hint="ScanDex Token"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <TextBox x:Name="TxtIgdbClientId" Margin="0,16,0,0"
                         md:HintAssist.Hint="IGDB Client ID"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <TextBox x:Name="TxtIgdbClientSecret" Margin="0,16,0,0"
                         md:HintAssist.Hint="IGDB Client Secret"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <TextBox x:Name="TxtRawg" Margin="0,16,0,0"
                         md:HintAssist.Hint="RAWG API Key"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <TextBox x:Name="TxtGamesDb" Margin="0,16,0,0"
                         md:HintAssist.Hint="TheGamesDB API Key"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <Separator x:Name="SwitchDbSeparator" Margin="0,24,0,0"/>

                <StackPanel x:Name="SwitchDbSection" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="DatabaseSyncOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Colección" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Nombre visible de la colección" FontSize="11" FontWeight="Medium"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,10,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCollectionName" Grid.Column="0" Margin="0,0,8,0"
                                 md:HintAssist.Hint="p. ej. Mis juegos de PS5"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <Button Grid.Column="1" Content="GUARDAR" Click="BtnSaveCollectionName_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                md:ButtonAssist.CornerRadius="4"/>
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,16" FontSize="11"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Text="Solo cambia cómo se ve dentro de la app — no afecta al archivo .db."/>

                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Text="Abre otra colección existente (.db) o crea una nueva, sin cerrar la app."/>
                    <Button x:Name="BtnSwitchDatabase" Content="ABRIR OTRA COLECCIÓN..." Click="BtnSwitchDatabase_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            HorizontalAlignment="Left" Margin="0,0,0,8"
                            md:ButtonAssist.CornerRadius="4"/>
                    <Button x:Name="BtnRenameDbFile" Content="RENOMBRAR ARCHIVO .DB..." Click="BtnRenameDbFile_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            HorizontalAlignment="Left"
                            md:ButtonAssist.CornerRadius="4"/>
                </StackPanel>

                <Separator x:Name="MaintenanceSeparator" Margin="0,24,0,0"/>

                <StackPanel x:Name="MaintenanceSection" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="DatabaseCogOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Mantenimiento" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,10" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Text="Guarda una copia de seguridad de tu colección en el archivo que elijas. Recomendado antes de importar un lote grande o de vez en cuando por si acaso."/>
                    <Button x:Name="BtnBackup" Content="GUARDAR COPIA DE SEGURIDAD..." Click="BtnBackup_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            HorizontalAlignment="Left" Margin="0,0,0,4"
                            md:ButtonAssist.CornerRadius="4"/>
                    <TextBlock x:Name="TxtLastBackup" TextWrapping="Wrap" Margin="0,0,0,16" FontSize="11" FontWeight="Medium"/>

                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Text="Al borrar un juego, el archivo .db no reduce su tamaño ni elimina físicamente los datos hasta que se compacta. Esto es normal en SQLite y no afecta al funcionamiento de la app, pero puedes compactarlo manualmente cuando quieras."/>
                    <Button x:Name="BtnVacuum" Content="COMPACTAR BASE DE DATOS" Click="BtnVacuum_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            HorizontalAlignment="Left" Margin="0,0,0,16"
                            md:ButtonAssist.CornerRadius="4"/>

                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Text="Busca juegos que probablemente estén repetidos en tu colección (mismo código de barras, o mismo título y plataforma si no lo tienen), por ejemplo tras añadir el mismo juego a mano dos veces."/>
                    <Button x:Name="BtnFindDuplicates" Content="BUSCAR DUPLICADOS" Click="BtnFindDuplicates_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            HorizontalAlignment="Left"
                            md:ButtonAssist.CornerRadius="4"/>
                </StackPanel>

                <Separator x:Name="ImportSeparator" Margin="0,24,0,0"/>

                <StackPanel x:Name="ImportSection" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="FileImportOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Importar colección" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,8" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Text="Importa juegos desde un CSV (separado por punto y coma) o Excel (.xlsx) con una fila de cabecera. A continuación podrás indicar qué columna del archivo corresponde a cada campo — si usan estos nombres se detectan solas, si no, las emparejas a mano. Solo &quot;Título&quot; es obligatorio:"/>
                    <Border Background="{DynamicResource MaterialDesignChipBackground}" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <TextBlock TextWrapping="Wrap" FontSize="11" FontFamily="Consolas"
                                   Text="Código de Barras · Título · Plataforma · Editorial · Género · Etiquetas · Año · Puntuación · Notas · Jugado"/>
                    </Border>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="11"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Text="Puntuación: número del 0 al 5. Jugado: Sí/No. Un código de barras que ya exista en la colección se omite (no se duplica)."/>
                    <Button x:Name="BtnImport" Content="IMPORTAR DESDE CSV/EXCEL" Click="BtnImport_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            HorizontalAlignment="Left"
                            md:ButtonAssist.CornerRadius="4"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnCancel" Content="CANCELAR" Click="BtnCancel_Click" IsCancel="True"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
            <Button Content="GUARDAR" Click="BtnSave_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    md:ButtonAssist.CornerRadius="4"/>
        </StackPanel>
    </Grid>
    </md:DialogHost>
</Window>
