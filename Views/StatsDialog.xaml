<Window x:Class="VideoGameLibrary.Views.StatsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:VideoGameLibrary.Converters"
        Title="Estadísticas de la colección" Height="620" Width="520"
        MinHeight="480" MinWidth="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:IntZeroToVisibilityConverter x:Key="ZeroToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <md:PackIcon Kind="ChartBar" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Estadísticas de tu colección" FontSize="18" FontWeight="Medium" VerticalAlignment="Center"/>
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <StackPanel>

                <!-- Totales -->
                <UniformGrid Columns="3" Margin="0,0,0,20">
                    <md:Card Margin="0,0,6,0" Padding="12" UniformCornerRadius="8" md:ElevationAssist.Elevation="Dp1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalGames}" FontSize="26" FontWeight="Medium" HorizontalAlignment="Center"/>
                            <TextBlock Text="Total" FontSize="11" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </md:Card>
                    <md:Card Margin="6,0" Padding="12" UniformCornerRadius="8" md:ElevationAssist.Elevation="Dp1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PlayedCount}" FontSize="26" FontWeight="Medium" HorizontalAlignment="Center"/>
                            <TextBlock Text="Jugados" FontSize="11" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </md:Card>
                    <md:Card Margin="6,0,0,0" Padding="12" UniformCornerRadius="8" md:ElevationAssist.Elevation="Dp1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PlayedPercentageText}" FontSize="26" FontWeight="Medium" HorizontalAlignment="Center"/>
                            <TextBlock Text="% jugado" FontSize="11" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </md:Card>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" Margin="0,-12,0,20"
                            Visibility="{Binding WishlistCount, Converter={StaticResource ZeroToVis}, ConverterParameter=invert}">
                    <md:PackIcon Kind="HeartOutline" Width="14" Height="14" VerticalAlignment="Center"
                                 Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,4,0"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}">
                        <Run Text="{Binding WishlistCount}" FontWeight="Medium"/>
                        <Run Text=" en tu lista de deseos (no incluidos arriba)"/>
                    </TextBlock>
                </StackPanel>

                <!-- Por plataforma -->
                <TextBlock Text="Por plataforma" FontWeight="Medium" FontSize="14" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding ByPlatform}" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Height="8" VerticalAlignment="Center" Margin="8,0"
                                             Minimum="0" Maximum="{Binding Total}" Value="{Binding Count, Mode=OneTime}"/>
                                <TextBlock Grid.Column="2" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}">
                                    <Run Text="{Binding Count, Mode=OneTime}"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding PercentageText, Mode=OneTime}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Por género -->
                <TextBlock Text="Por género" FontWeight="Medium" FontSize="14" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding ByGenre}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Height="8" VerticalAlignment="Center" Margin="8,0"
                                             Minimum="0" Maximum="{Binding Total}" Value="{Binding Count, Mode=OneTime}"/>
                                <TextBlock Grid.Column="2" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}">
                                    <Run Text="{Binding Count, Mode=OneTime}"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding PercentageText, Mode=OneTime}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Por etiquetas (solo si el usuario ha puesto alguna) -->
                <StackPanel Visibility="{Binding ByTags.Count, Converter={StaticResource ZeroToVis}, ConverterParameter=invert}">
                    <TextBlock Text="Por etiquetas" FontWeight="Medium" FontSize="14" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding ByTags}" Margin="0,0,0,20">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Height="8" VerticalAlignment="Center" Margin="8,0"
                                                 Minimum="0" Maximum="{Binding Total}" Value="{Binding Count, Mode=OneTime}"/>
                                    <TextBlock Grid.Column="2" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <Run Text="{Binding Count, Mode=OneTime}"/>
                                        <Run Text=" ("/>
                                        <Run Text="{Binding PercentageText, Mode=OneTime}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Progreso por año (año en que se añadieron a la colección) -->
                <TextBlock Text="Progreso por año" FontWeight="Medium" FontSize="14" Margin="0,20,0,8"/>
                <ItemsControl ItemsSource="{Binding ByYearAdded}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Height="8" VerticalAlignment="Center" Margin="8,0"
                                             Minimum="0" Maximum="{Binding Total}" Value="{Binding Count, Mode=OneTime}"/>
                                <TextBlock Grid.Column="2" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}">
                                    <Run Text="{Binding Count, Mode=OneTime}"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding PercentageText, Mode=OneTime}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Tu colección está vacía." Margin="0,20,0,0"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           Visibility="{Binding TotalGames, Converter={StaticResource ZeroToVis}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="CERRAR" Click="BtnClose_Click" IsCancel="True"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    md:ButtonAssist.CornerRadius="4"/>
        </StackPanel>
    </Grid>
</Window>
