<Window x:Class="VideoGameLibrary.Views.TrashDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:VideoGameLibrary.Converters"
        Title="Papelera" Height="560" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <conv:ByteArrayToImageConverter x:Key="ByteToImg"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:DeletedDateToDaysLeftConverter x:Key="DaysLeft"/>
    </Window.Resources>

    <md:DialogHost Identifier="TrashDialogHost">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="TrashCanOutline" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Papelera" FontSize="18" FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Text="Los juegos eliminados se guardan aquí 7 días antes de borrarse para siempre. Puedes restaurarlos mientras tanto."/>
        </StackPanel>

        <!-- Lista -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="0,0,0,4" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4"
                                            ClipToBounds="True" Margin="0,0,10,0">
                                        <Grid Background="{DynamicResource MaterialDesignChipBackground}">
                                            <Image Source="{Binding CoverData, Converter={StaticResource ByteToImg}, ConverterParameter=80}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{Binding CoverData, Converter={StaticResource NullToVis}}"/>
                                            <md:PackIcon Kind="GamepadVariant" Width="18" Height="18"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                         Visibility="{Binding CoverData, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="13"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                            <Run Text="{Binding Platform, Mode=OneWay}"/>
                                            <Run Text=" · Eliminado el "/>
                                            <Run Text="{Binding DeletedDate, Mode=OneWay, StringFormat='dd/MM/yyyy'}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#FFA000" FontWeight="Medium" Margin="0,2,0,0"
                                                    Text="{Binding DeletedDate, Mode=OneWay, Converter={StaticResource DaysLeft}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Restaurar" Width="32" Height="32"
                                                Click="BtnRestore_Click" Tag="{Binding}">
                                            <md:PackIcon Kind="DeleteRestore" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Eliminar definitivamente" Width="32" Height="32"
                                                Foreground="OrangeRed"
                                                Click="BtnDeleteForever_Click" Tag="{Binding}">
                                            <md:PackIcon Kind="DeleteForever" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="TxtEmpty" Text="La papelera está vacía." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" Visibility="Collapsed"/>
        </Grid>

        <!-- Botones -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnEmptyTrash" Content="VACIAR PAPELERA" Click="BtnEmptyTrash_Click"
                    Foreground="OrangeRed"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
            <Button Content="CERRAR" Click="BtnClose_Click" IsCancel="True"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    md:ButtonAssist.CornerRadius="4"/>
        </StackPanel>
    </Grid>
    </md:DialogHost>
</Window>
